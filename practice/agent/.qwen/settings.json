{
  "$version": 4,
  "modelProviders": {
    "openai": [
      {
        "id": "agentic/gc_v3",
        "name": "agentic/gc_v3",
        "baseUrl": "https://llmhub.sberai-rnd.ru/v1",
        "envKey": "MODEL_API_KEY",
        "generationConfig": {
          "samplingParams": {
            "temperature": 0.8,
            "top_p": 0.95,
            "max_tokens": 65536
          }
        }
      }
    ]
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "hooks": {
  "PreToolUse": [
    {
      "matcher": "^(run_shell_command|mcp__todo__.*)$",
      "hooks": [
        {
          "type": "command",
          "command": "python \"$QWEN_PROJECT_DIR/.qwen/hooks/guard.py\"",
          "name": "todo-guard",
          "timeout": 10
        }
      ]
    }
  ]
},
  "mcpServers": {
    "todo": {
      "command": "/Users/lendwye/anaconda3/envs/aidd-mcp/bin/python",
      "args": ["/Users/lendwye/Documents/VSC/aidd_week_04_mcp/practice/mcp/server.py"],
      "env": {
        "TODO_API_URL": "http://127.0.0.1:5001",
        "NO_PROXY": "127.0.0.1,localhost",
        "no_proxy": "127.0.0.1,localhost"
      }
    }
  },
  "model": {
    "name": "<model_name>",
    "baseUrl": "<model_url>"
  },
  "context": {
    "fileName": ["QWEN.md"]
  },
  "memory": {
    "enableManagedAutoMemory": false,
    "enableManagedAutoDream": false
  }
}